/*
 * Charybdis ZMK Keymap - Converted from VIA layout
 *
 * VIA layout 가정: 4x6 + 5+3 thumb (active keys)
 * Right side는 VIA에서 outer→inner 순서로 저장되어 있어 ZMK용으로 reverse 적용
 *
 * 호환 안 되는 키들 (모두 &none 처리됨):
 *   - CUSTOM(0~3): 트랙볼 DPI 조절 (Layer 3) — ZMK는 zip_xy_scaler 정적 설정
 *   - CUSTOM(6): Sniping 토글 (Layer 3) — ZMK는 별도 레이어로 처리
 *   - KC_MS_ACCEL0/1/2: 마우스 가속 단계 (Layer 3) — ZMK는 mmv 설정 사용
 *
 * 부분 호환:
 *   - KC_HAEN: 한영키 → &kp LANG1 (작동 안 하면 INT5 등 시도 필요)
 *
 * Hold-tap 파라미터: macOS 친화적으로 설정 (tap-preferred + require-prior-idle-ms)
 */

#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &charybdis_6col_layout; };
};

// macOS 친화적 hold-tap 설정 (stuck 방지)
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        // VIA의 multi-modifier MT() 변환용 custom hold-tap
        // 예: MT(MOD_LSFT|MOD_LALT|MOD_LGUI, KC_W) → &mtm LS(LA(LGUI)) W
        mtm: mod_tap_multi {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        // VIA MACRO(0): U → 200ms → O → 100ms → I
        macro_uoi: macro_uoi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp U>
                , <&macro_wait_time 200>
                , <&macro_tap &kp O>
                , <&macro_wait_time 100>
                , <&macro_tap &kp I>
                ;
        };

        // VIA MACRO(1): 2 → 200ms → SPACE  (현재 keymap에서 사용 안 됨)
        macro_2sp: macro_2sp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp N2>
                , <&macro_wait_time 200>
                , <&macro_tap &kp SPACE>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ===========================================================================
        // Layer 0 (BASE) - 홈로우 모드 + Hyper 키 매핑
        // ===========================================================================
        layer_0 {
            label = "BASE";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
&kp N1              &kp N2          &kp N3          &kp N4          &kp N5          &kp N6                                                                  &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&kp ESC             &kp Q           &mtm LS(LA(LGUI)) W  &mtm LC(LA(LGUI)) E  &kp R           &kp T                                                          &kp Y           &kp U           &kp I           &kp O           &kp P           &kp BSLH
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&mt LCTRL TAB       &mt LSHIFT A    &lt 2 S         &lt 1 D         &lt 2 F         &lt 3 G                                                                  &kp H           &kp J           &kp K           &kp L           &mt LSHIFT SEMI &mt LCTRL SQT
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&mt LALT GRAVE      &mtm LS(LALT) Z &mt LALT X      &lt 3 C         &mtm LC(LS(LGUI)) V  &mtm LC(LS(LGUI)) B                                                  &mtm LC(LS(LGUI)) N  &mtm LC(LS(LGUI)) M  &mt LGUI COMMA  &mt LALT DOT    &mtm LS(LALT) FSLH  &mt LALT RET
// ╰───────────────┴───────────────┴───────────────┴───────────────┴───────────────┴───────────────╯   ╰───────────────┴───────────────┴───────────────┴───────────────┴───────────────┴───────────────╯
                                    &mkp LCLK       &kp RBKT        &kp F19         &mt LGUI BSPC   &kp LBKT                                                   &kp PG_UP       &lt 1 SPACE     &kp PG_DN
            >;
        };

        // ===========================================================================
        // Layer 1 - 미디어/네비게이션/숫자 패드
        // ===========================================================================
        layer_1 {
            label = "L1";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
&kp C_VOL_DN        &kp C_MUTE      &kp C_VOL_UP    &kp C_PREV      &kp C_PP        &kp C_NEXT                                                              &none           &none           &none           &none           &none           &none
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&kp LS(TAB)         &none           &kp LG(LBKT)    &kp LC(LA(LG(RBKT)))  &kp LG(RBKT)    &kp LC(LG(RBKT))                                                   &kp LANG1       &kp N7          &kp N8          &kp N9          &kp KP_DIVIDE   &kp KP_MULTIPLY
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&kp LS(TAB)         &kp LSHIFT      &kp LS(LG(LBKT))  &kp LS(LG(LBKT))  &kp LS(LG(RBKT))  &kp LC(RBKT)                                                       &kp RET         &kp LS(MINUS)   &kp N4          &kp N5          &kp N6          &kp KP_MINUS
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&kp LCTRL           &none           &kp LC(LEFT)    &kp LC(C)       &kp LC(RIGHT)   &kp F19                                                                  &kp LS(GRAVE)   &kp N1          &kp N2          &kp N3          &kp DOT         &kp KP_PLUS
// ╰───────────────┴───────────────┴───────────────┴───────────────┴───────────────┴───────────────╯   ╰───────────────┴───────────────┴───────────────┴───────────────┴───────────────┴───────────────╯
                                    &mkp RCLK       &none           &kp RET         &mt LGUI BSPC   &none                                                     &kp COMMA       &kp N0          &kp LS(N1)
            >;
        };

        // ===========================================================================
        // Layer 2 - 심볼/네비게이션/매크로
        // ===========================================================================
        layer_2 {
            label = "L2";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
&kp LS(N1)          &kp LS(N2)      &kp LS(N3)      &kp LS(N4)      &kp LS(N5)      &kp LS(N6)                                                              &kp LS(N7)      &kp LS(N8)      &kp LS(N9)      &kp LS(N0)      &kp LS(MINUS)   &kp LS(EQUAL)
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&kp LG(TAB)         &none           &none           &none           &none           &kp LS(LG(N4))                                                          &kp LANG1       &macro_uoi      &none           &none           &none           &kp LC(LS(LG(PG_DN)))
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&kp LCTRL           &kp LSHIFT      &kp LC(LS(LG(N4)))  &kp LS(LG(N4))  &kp LSHIFT      &kp LC(LG(RBKT))                                                    &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &kp LS(SEMI)    &kp LC(LS(LG(RET)))
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&none               &none           &none           &none           &none           &none                                                                    &kp F19         &kp F18         &kp F20         &kp LC(LS(LG(LEFT)))  &kp LC(LS(LG(RIGHT)))  &kp RET
// ╰───────────────┴───────────────┴───────────────┴───────────────┴───────────────┴───────────────╯   ╰───────────────┴───────────────┴───────────────┴───────────────┴───────────────┴───────────────╯
                                    &none           &none           &kp RET         &mt LGUI BSPC   &none                                                     &kp F18         &lt 1 SPACE     &kp F20
            >;
        };

        // ===========================================================================
        // Layer 3 - 트랙볼 컨트롤 / 시스템 (CUSTOM 키들은 ZMK 미지원)
        // ===========================================================================
        // 호환 안 되는 키들이 모두 이 레이어에 있음:
        //   CUSTOM(0~3): DPI 조절 → ZMK는 zip_xy_scaler 정적 설정으로 대체 (변경 불가)
        //   CUSTOM(6): Sniping toggle → ZMK는 별도 레이어로 처리
        //   KC_MS_ACCEL0/1/2: 마우스 가속 단계 → ZMK는 mmv 설정으로 처리
        // 모두 &none 처리.
        layer_3 {
            label = "L3";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
&none               &none           &none           &none           &none           &none                                                                    &kp LA(LC(LEFT))  &kp LA(LC(DOWN))  &kp LA(LC(UP))  &kp LA(LC(RIGHT))  &none           &none
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&none               &none           &none           &none           &none           &none                                                                    &none           &kp LG(N2)      &kp LS(LG(R))   &kp LG(N4)      &none           &kp C_SLEEP
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&kp LCTRL           &kp LSHIFT      &none           &none           &none           &none                                                                    &none           &none           &none           &none           &none           &none
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
&none               &none           &none           &none           &none           &none                                                                    &kp LG(N1)      &kp LS(LG(A))   &kp LG(N3)      &kp LS(LG(S))   &kp LS(LG(R))   &none
// ╰───────────────┴───────────────┴───────────────┴───────────────┴───────────────┴───────────────╯   ╰───────────────┴───────────────┴───────────────┴───────────────┴───────────────┴───────────────╯
                                    &none           &none           &kp LSHIFT      &mt LGUI BSPC   &none                                                     &none           &none           &none
            >;
        };
    };
};
